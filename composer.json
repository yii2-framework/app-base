{
    "name": "yii2-framework/app-base",
    "type": "yii2-scaffold",
    "description": "Shared Yii2 scaffold with standalone actions, authentication, RBAC, mail, views, and CLI tooling.",
    "keywords": [
        "yii2",
        "scaffold",
        "backend",
        "rbac",
        "sqlite"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ui-awesome/form-model": "^0.2",
        "ui-awesome/html": "^0.6",
        "ui-awesome/html-core-component": "^0.4",
        "ui-awesome/html-field": "^0.1",
        "ui-awesome/html-interop": "^0.4",
        "ui-awesome/model": "^0.2",
        "yiisoft/yii2": "^22.0@dev",
        "yiisoft/yii2-symfonymailer": "^4.0|^22.0@dev"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.3",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-yii2": "^2.0",
        "codeception/verify": "^3.4",
        "maglnet/composer-require-checker": "~4.17.0",
        "php-forge/baseline": "^0.1@dev",
        "php-forge/coding-standard": "^0.3@dev",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "yii2-extensions/debug": "^0.2",
        "yii2-extensions/phpstan": "^0.5",
        "php-forge/scaffold": "^0.3@dev"
    },
    "autoload": {
        "psr-4": {
            "app\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "app\\tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "scaffold": {
            "allowed-packages": [
                "php-forge/baseline",
                "php-forge/coding-standard"
            ],
            "manifest": "scaffold.json"
        },
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0775",
                    "public/assets": "0775",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/params.php"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-forge/scaffold": true,
            "phpstan/extension-installer": true,
            "yii2-extensions/scaffold": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check-dependencies": "./vendor/bin/composer-require-checker check",
        "ecs": "./vendor/bin/ecs --fix",
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ],
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "rector": "./vendor/bin/rector process",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "tests": "vendor/bin/codecept run"
    }
}
